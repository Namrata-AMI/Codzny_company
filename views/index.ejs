    <script>
        // Mobile navigation
        const menuToggle = document.querySelector(".menu-toggle");
        const navigation = document.querySelector(".topbar-center");

        menuToggle?.addEventListener("click", () => {
            navigation.classList.toggle("menu-open");

            menuToggle.innerHTML = navigation.classList.contains("menu-open")
                ? '<i class="fa-solid fa-xmark"></i>'
                : '<i class="fa-solid fa-bars"></i>';
        });

        navigation?.querySelectorAll("a").forEach(link => {
            link.addEventListener("click", () => {
                navigation.classList.remove("menu-open");
                if (menuToggle) {
                    menuToggle.innerHTML = '<i class="fa-solid fa-bars"></i>';
                }
            });
        });
    </script>




<script>
    const horizontalSection = document.querySelector(".horizontal-scroll");
    const horizontalTrack = document.querySelector(".horizontal-track");

    function updateHorizontalScroll() {
        if (!horizontalSection || !horizontalTrack) return;

        if (window.innerWidth <= 700) {
            horizontalTrack.style.transform = "none";
            return;
        }

        const sectionTop = horizontalSection.offsetTop;
        const scrollDistance =
            horizontalSection.offsetHeight - window.innerHeight;

        if (scrollDistance <= 0) return;

        const scrollProgress = Math.max(
            0,
            Math.min(
                1,
                (window.scrollY - sectionTop) / scrollDistance
            )
        );

        horizontalTrack.style.transform =
            `translateX(-${scrollProgress * 50}%)`;
    }

    window.addEventListener("scroll", updateHorizontalScroll);
    window.addEventListener("resize", updateHorizontalScroll);

    updateHorizontalScroll();
</script>






